{
  "name": "bass-reference-workstation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b && tsx --test tests/*.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "content:import": "python3 scripts/import_book.py",
    "test:browser": "node scripts/qa-functional.mjs",
    "test:visual": "node scripts/qa-browser.mjs",
    "format": "prettier --write src scripts/*.mjs tests/*.ts vite.config.ts index.html README.md docs/*.md package.json tsconfig.json public/manifest.webmanifest .prettierrc.json"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "vexflow": "4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
